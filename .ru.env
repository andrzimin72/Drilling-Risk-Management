# =============================================================================
# Drilling Risk Management System — Environment Configuration
# Система управления рисками бурения — Конфигурация окружения
# =============================================================================
#
# ВАЖНО / IMPORTANT:
# • Этот файл содержит конфиденциальные данные (API ключи, секреты)
# • НИКОГДА не коммитьте его в Git! (уже добавлен в .gitignore)
# • Скопируйте из .env.example и заполните свои значения
#
# This file contains sensitive data (API keys, secrets)
# NEVER commit this to Git! (already in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# 🌐 General Settings / Основные настройки
# -----------------------------------------------------------------------------
# Язык интерфейса и отчётов: "ru" (русский) или "en" (английский)
# Language for UI and reports: "ru" (Russian) or "en" (English)
APP_LANGUAGE=ru

# Окружение: "development", "staging", "production"
# Environment: "development", "staging", "production"
APP_ENV=development

# Уровень логирования: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# Log level: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
LOG_LEVEL=INFO

# Режим отладки (подробные логи, детальные ошибки)
# Debug mode (verbose logging, detailed errors)
DEBUG_MODE=false

# -----------------------------------------------------------------------------
# 🔑 LLM API Keys / Ключи API для языковых моделей
# -----------------------------------------------------------------------------
# Anthropic Claude API ключ (для Vision LLM — извлечение таблиц из PDF)
# Anthropic Claude API key (for Vision LLM — table extraction from PDFs)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Модель Claude для Vision fallback
# Claude model for Vision fallback
VISION_MODEL=claude-sonnet-4-5

# OpenAI API ключ (для AutoGen adapter) — опционально
# OpenAI API key (for AutoGen adapter) — optional
# OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# -----------------------------------------------------------------------------
# 📊 Observability / Наблюдаемость (OpenTelemetry)
# -----------------------------------------------------------------------------
# Включить/выключить трейсинг: "true" или "false"
# Enable/disable tracing: "true" or "false"
ENABLE_TELEMETRY=false

# OTLP endpoint для Jaeger/Grafana Tempo (оставьте пустым для console-only)
# OTLP endpoint for Jaeger/Grafana Tempo (leave empty for console-only)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Имя сервиса для трейсинга
# Service name for tracing
OTEL_SERVICE_NAME=oil_gas_swarm

# -----------------------------------------------------------------------------
# 💾 Data Storage Paths / Пути хранения данных
# -----------------------------------------------------------------------------
# Директория для SQLite кеша
# SQLite cache directory
CACHE_DIR=.cache/oil_gas_swarm

# Путь к базе данных чекпоинтов (для восстановления после сбоев)
# Checkpoint database path (for crash recovery)
CHECKPOINT_DB_PATH=.cache/swarm_checkpoints.db

# Путь к базе данных истории анализов
# Analysis history database path
HISTORY_DB_PATH=.cache/analysis_history.db

# Путь к векторному хранилищу ChromaDB (для RAG)
# ChromaDB vector store path (for RAG)
RAG_DB_PATH=.cache/rag_risk_db

# -----------------------------------------------------------------------------
# 🚀 Feature Flags / Флаги функций
# -----------------------------------------------------------------------------
# Vision LLM fallback для нечитаемых PDF
# Vision LLM fallback for unreadable PDFs
ENABLE_VISION_FALLBACK=true

# RAG-based предиктивный анализ рисков
# RAG-based predictive risk advisor
ENABLE_RAG_RISK_ADVISOR=true

# SQLite чекпоинтинг для восстановления после сбоев
# SQLite checkpointing for crash recovery
ENABLE_CHECKPOINTING=true

# SQLite кеш для результатов парсеров
# SQLite file cache for parser results
ENABLE_FILE_CACHE=true

# Система управления рисками (Pillar 4)
# Risk management system (Pillar 4)
ENABLE_RISK_MANAGEMENT=true

# Генерация Word отчётов
# Word report generation
ENABLE_WORD_REPORTS=true

# Экспорт в PDF
# PDF export
ENABLE_PDF_EXPORT=true

# -----------------------------------------------------------------------------
# 🧪 Petrophysics Defaults / Петрофизические отсечки по умолчанию
# -----------------------------------------------------------------------------
# Отсечки для идентификации продуктивных интервалов
# Cutoffs for pay zone identification
#
# Западная Сибирь (терригенные): GR=60, RT=15
# Western Siberia (clastics): GR=60, RT=15
#
# US Shale (Eagle Ford): GR=75, RT=10
# US Shale (Eagle Ford): GR=75, RT=10
#
# Ближний Восток (карбонаты): GR=50, RT=20
# Middle East (carbonates): GR=50, RT=20

DEFAULT_GR_CUTOFF=75.0
DEFAULT_RT_CUTOFF=10.0

# Минимальная толщина продуктивного интервала (в метрах или футах)
# Minimum net pay thickness (in meters or feet, depending on data)
MIN_NET_PAY_THICKNESS=1.0

# -----------------------------------------------------------------------------
# ⚡ Performance Settings / Настройки производительности
# -----------------------------------------------------------------------------
# Максимум строк таблицы для LAS файлов (None = без ограничений)
# Maximum table rows for LAS files (None = unlimited)
MAX_LAS_TABLE_ROWS=5000

# Максимум станций съёмки на файл
# Maximum survey stations per file
MAX_SURVEY_STATIONS=1000

# Максимум NPT событий на документ
# Maximum NPT events per document
MAX_NPT_EVENTS=50

# Конфигурация retry для I/O
# I/O retry configuration
IO_MAX_RETRIES=3
IO_RETRY_BASE_DELAY=0.5

# Размер пула потоков для параллельного выполнения парсеров
# Thread pool size for parallel parser execution
ASYNC_THREAD_POOL_SIZE=10

# -----------------------------------------------------------------------------
# 🔌 MCP Server Settings / Настройки MCP сервера
# -----------------------------------------------------------------------------
# Хост и порт MCP сервера (для HTTP режима)
# MCP server host and port (for HTTP mode)
MCP_HOST=0.0.0.0
MCP_PORT=8342

# -----------------------------------------------------------------------------
# 🖥️ Streamlit Dashboard Settings / Настройки Streamlit Dashboard
# -----------------------------------------------------------------------------
# Конфигурация сервера dashboard
# Dashboard server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_SERVER_ADDRESS=localhost

# Максимальный размер загружаемого файла (в МБ)
# Maximum upload file size (in MB)
STREAMLIT_MAX_UPLOAD_SIZE=200

# -----------------------------------------------------------------------------
# 🇷🇺 Gazprom Neft Specific Settings / Специфичные настройки Газпром нефти
# -----------------------------------------------------------------------------
# Система единиц по умолчанию: "metric" или "imperial"
# Default unit system: "metric" or "imperial"
DEFAULT_UNIT_SYSTEM=metric

# Паттерны имён скважин и кустов (regex)
# Well and pad naming patterns (regex)
RUSSIAN_WELL_PATTERN=(?:скважина|скв\.?)\s*№?\s*([A-Za-z0-9А-Яа-я\-]+)
RUSSIAN_PAD_PATTERN=(?:куст|куст\.?)\s*№?\s*([A-Za-z0-9А-Яа-я\-]+)

# Название компании для отчётов
# Company name for reports
COMPANY_NAME=ПАО «Газпром нефть»
COMPANY_NAME_EN=Gazprom Neft PJSC

# -----------------------------------------------------------------------------
# 🔒 Data Sovereignty & Compliance / Суверенитет данных и комплаенс (152-ФЗ)
# -----------------------------------------------------------------------------
# Все данные должны храниться в пределах РФ
# All data must stay within Russian Federation
DATA_SOVEREIGNTY_ENABLED=true

# Шифрование при хранении (GOST R 34.12-2015 "Кузнечик")
# Encryption at rest (GOST R 34.12-2015 "Kuznechik")
ENCRYPTION_ENABLED=false
# ENCRYPTION_KEY_PATH=/etc/gazprom_neft/encryption.key

# Аудит-логирование
# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=.cache/audit.log

# -----------------------------------------------------------------------------
# 🏢 Air-Gapped Deployment / Развёртывание в изолированном контуре
# -----------------------------------------------------------------------------
# Для полностью автономного развёртывания (без внешних API вызовов)
# For fully offline deployment (no external API calls)
AIR_GAPPED_MODE=false

# Endpoint локальной LLM (для air-gapped режима)
# Local LLM endpoint (for air-gapped mode)
# Примеры / Examples: Ollama, vLLM, TGI
# LOCAL_LLM_ENDPOINT=http://localhost:11434
# LOCAL_LLM_MODEL=saiga_llama3

# -----------------------------------------------------------------------------
# 🧪 Development Settings / Настройки разработки
# -----------------------------------------------------------------------------
# Режим тестирования (синтетические данные, пропуск внешних вызовов)
# Test mode (synthetic data, skip external calls)
TEST_MODE=false

# Mock API ответов (для тестирования без API ключей)
# Mock API responses (for testing without API keys)
MOCK_APIS=false

# =============================================================================
# 📝 Quick Start Guide / Краткое руководство по запуску
# =============================================================================
#
# 1. Заполните ANTHROPIC_API_KEY (обязательно для Vision LLM)
#    Fill in ANTHROPIC_API_KEY (required for Vision LLM)
#
# 2. Для локальной разработки установите:
#    For local development, install:
#    $ pip install -r requirements.txt
#
# 3. Запустите dashboard:
#    Run the dashboard:
#    $ streamlit run dashboard.py
#
# 4. Запустите тесты:
#    Run tests:
#    $ pytest tests/ -v
#
# 5. Запустите demo:
#    Run the demo:
#    $ python -m swarms.demo
#
# =============================================================================