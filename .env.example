# =============================================================================
# Drilling Risk Management System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
# Primary language for reports and UI: "ru" (Russian) or "en" (English)
APP_LANGUAGE=ru

# Application environment: "development", "staging", "production"
APP_ENV=production

# Log level: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM API Keys (for Vision LLM fallback and AI adapters)
# -----------------------------------------------------------------------------
# Anthropic Claude API key (for Vision LLM PDF extraction)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model for Vision fallback
VISION_MODEL=claude-sonnet-4-5

# OpenAI API key (for AutoGen adapter)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# Enable/disable telemetry: "true" or "false"
ENABLE_TELEMETRY=true

# OTLP collector endpoint (Jaeger, Grafana Tempo, etc.)
# Leave empty to disable OTLP export (console only)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name for tracing
OTEL_SERVICE_NAME=oil_gas_swarm

# -----------------------------------------------------------------------------
# Data Storage Paths
# -----------------------------------------------------------------------------
# SQLite cache directory
CACHE_DIR=.cache/oil_gas_swarm

# Checkpoint database path (for crash recovery)
CHECKPOINT_DB_PATH=.cache/swarm_checkpoints.db

# Analysis history database path
HISTORY_DB_PATH=.cache/analysis_history.db

# ChromaDB vector store path (for RAG risk prediction)
RAG_DB_PATH=.cache/rag_risk_db

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable specific features: "true" or "false"

# Vision LLM fallback for unreadable PDFs
ENABLE_VISION_FALLBACK=true

# RAG-based predictive risk advisor
ENABLE_RAG_RISK_ADVISOR=true

# SQLite checkpointing for crash recovery
ENABLE_CHECKPOINTING=true

# SQLite file cache for parser results
ENABLE_FILE_CACHE=true

# Risk management system (Pillar 4)
ENABLE_RISK_MANAGEMENT=true

# Word report generation
ENABLE_WORD_REPORTS=true

# PDF export
ENABLE_PDF_EXPORT=true

# -----------------------------------------------------------------------------
# Petrophysics Defaults
# -----------------------------------------------------------------------------
# Default cutoffs for pay zone identification (can be overridden per analysis)
# Western Siberia clastics: GR=60, RT=15
# US Shale (Eagle Ford): GR=75, RT=10
# Middle East carbonates: GR=50, RT=20

DEFAULT_GR_CUTOFF=75.0
DEFAULT_RT_CUTOFF=10.0

# Minimum net pay thickness (in meters or feet, depending on data)
MIN_NET_PAY_THICKNESS=1.0

# -----------------------------------------------------------------------------
# Performance Settings
# -----------------------------------------------------------------------------
# Maximum table rows to extract from LAS files (None = unlimited)
MAX_LAS_TABLE_ROWS=5000

# Maximum survey stations to process per file
MAX_SURVEY_STATIONS=1000

# Maximum NPT events to extract per document
MAX_NPT_EVENTS=50

# I/O retry configuration
IO_MAX_RETRIES=3
IO_RETRY_BASE_DELAY=0.5

# Async thread pool size (for parallel parser execution)
ASYNC_THREAD_POOL_SIZE=10

# -----------------------------------------------------------------------------
# MCP Server Settings
# -----------------------------------------------------------------------------
# MCP server host and port (for HTTP mode)
MCP_HOST=0.0.0.0
MCP_PORT=8342

# -----------------------------------------------------------------------------
# Streamlit Dashboard Settings
# -----------------------------------------------------------------------------
# Dashboard server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_SERVER_ADDRESS=localhost

# Maximum upload file size (in MB)
STREAMLIT_MAX_UPLOAD_SIZE=200

# -----------------------------------------------------------------------------
# Gazprom Neft Specific Settings
# -----------------------------------------------------------------------------
# Default unit system for Gazprom Neft operations: "metric" or "imperial"
DEFAULT_UNIT_SYSTEM=metric

# Russian well naming patterns (regex)
RUSSIAN_WELL_PATTERN=(?:скважина|скв\.?)\s*№?\s*([A-Za-z0-9А-Яа-я\-]+)
RUSSIAN_PAD_PATTERN=(?:куст|куст\.?)\s*№?\s*([A-Za-z0-9А-Яа-я\-]+)

# Branding for reports
COMPANY_NAME=ПАО «Газпром нефть»
COMPANY_NAME_EN=Gazprom Neft PJSC

# -----------------------------------------------------------------------------
# Data Sovereignty & Compliance (152-ФЗ)
# -----------------------------------------------------------------------------
# Ensure all data stays within Russian Federation
DATA_SOVEREIGNTY_ENABLED=true

# Encryption at rest (GOST R 34.12-2015 "Кузнечик")
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY_PATH=/etc/gazprom_neft/encryption.key

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/var/log/oil_gas_swarm/audit.log

# -----------------------------------------------------------------------------
# Air-Gapped Deployment Settings
# -----------------------------------------------------------------------------
# For fully offline deployment (no external API calls)
AIR_GAPPED_MODE=false

# Local LLM endpoint (for air-gapped mode)
# Examples: Ollama, vLLM, TGI
# LOCAL_LLM_ENDPOINT=http://localhost:11434
# LOCAL_LLM_MODEL=saiga_llama3

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Enable debug mode (verbose logging, detailed error messages)
DEBUG_MODE=false

# Enable test mode (use synthetic data, skip external calls)
TEST_MODE=false

# Mock API responses (for testing without API keys)
MOCK_APIS=false